{
  "name": "lan-doudizhu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "三人斗地主 · Vue 3 / TypeScript / WebSocket 局域网联机",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.9",
    "node": "22.23.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}

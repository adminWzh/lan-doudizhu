{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "client/src/**/*.ts",
    "client/src/**/*.vue",
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
